classDiagram
  class RegionSelector {
    -List~String~ regionList
    -String selectedRegion
    +showRegions() void
    +selectRegion(String region) void
  }
  class RouteSearchUI {
    -TextField originField
    -TextField destinationField
    -List~String~ recentList
    +onInput(String keyword) void
    +showAutoComplete(List~Station~ candidates) void
    +doSearch() void
  }
  class LocationService {
    -ApiClient apiClient
    +searchStations(String keyword, String region) List~Station~
    +staticStations(String keyword) List~Station~
  }
  class RouteCalculator {
    -ApiClient apiClient
    +searchRoutes(Station origin, Station dest) List~Route~
    +mapOdsayPaths(Object result) List~Route~
    +sortByTransfer(List~Route~ routes) List~Route~
  }
  class Route {
    -double totalDistance
    -int durationMin
    -int transferCount
    -int legIdx
    -List~RouteSegment~ legs
    +doTransfer() void
    +isLastLeg() boolean
  }
  class RouteSegment {
    -String line
    -String boardStation
    -Station alightStation
    -List~String~ stops
    +getAlightStation() Station
  }
  class Station {
    -String id
    -String name
    -double lat
    -double lng
    -String cls
    +getName() String
    +getLat() double
    +getLng() double
  }
  class NavigationManager {
    -Route route
    -LocationTracker tracker
    -GeofenceChecker geofence
    -AlertManager alertManager
    -double minAlight
    +startNavigation() void
    +arriveAt(int target) void
    +advance() void
    +stopNavigation() void
  }
  class LocationTracker {
    -int watchId
    -Location currentLocation
    +useGeolocation(boolean enabled) State
    +useWakeLock(boolean active) void
  }
  class Location {
    -double lat
    -double lng
    -double accuracy
  }
  class GeofenceChecker {
    -double preAlertRadius
    -double finalRadius
    -double passRadius
    +distM(Location a, Location b) double
    +geofenceLeg(List~Station~ stops, Location cur) Result
    +isPreAlert(double distance) boolean
    +isArrived(double distance) boolean
    +isPassed(double minDist, double curDist) boolean
  }
  class AlertManager {
    +firePre(Station station) void
    +fireTransfer(RouteSegment next) void
    +fireFinal(Station station) void
    +firePassed(Station station) void
    +vibrate(int[] pattern) void
    +announce(String text) void
    +speak(String text, boolean soundOn) void
  }
  class Alert {
    -String messageText
    -int[] vibrationPattern
    -String type
    +getMessage() String
  }
  class ApiClient {
    -String baseUrl
    +request(String endpoint, Map params) String
    +apiAvailable() boolean
  }
  class StorageManager {
    +addRecent(Station station) void
    +removeRecent(String name) void
    +saveSettings(boolean soundOn) void
    +loadSettings() Settings
  }

  RegionSelector --> RouteSearchUI : navigates
  RouteSearchUI ..> LocationService : uses
  RouteSearchUI ..> RouteCalculator : uses
  RouteSearchUI ..> StorageManager : uses
  LocationService --> ApiClient : uses
  RouteCalculator --> ApiClient : uses
  RouteCalculator ..> Route : creates
  Route "1" *-- "1..*" RouteSegment : legs
  RouteSegment --> Station : board / alight
  NavigationManager --> Route
  NavigationManager --> LocationTracker
  NavigationManager --> GeofenceChecker
  NavigationManager --> AlertManager
  LocationTracker --> Location
  GeofenceChecker ..> Station
  GeofenceChecker ..> Location
  AlertManager --> Alert
  StorageManager ..> Station
